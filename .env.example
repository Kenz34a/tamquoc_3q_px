# Có thể sao chép file này thành .env cho cài đặt cục bộ.
# Không đưa .env, mật khẩu hay cơ sở dữ liệu lên GitHub.
PORT=3001
API_PORT=3001
HOST=0.0.0.0
GAME_DATA_DIR=.data

# Đặt true khi public qua HTTPS/reverse proxy.
COOKIE_SECURE=false

# Tạo tài khoản bằng npm run admin:create (nhập mật khẩu ẩn trong terminal).
# Không có mật khẩu quản trị mặc định.
